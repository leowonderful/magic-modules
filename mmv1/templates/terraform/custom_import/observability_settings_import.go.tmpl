    ID := d.Id()
    var location string

    parts := strings.Split(ID, "/")
    if len(parts) != 5 {
        return nil, fmt.Errorf("invalid import ID format, expected <type>/<id>/locations/<location>/settings, got %s", ID)
    }

    scopeType := parts[0]
    scopeId := parts[1]
    if parts[2] != "locations" {
        return nil, fmt.Errorf("invalid import ID format, missing 'locations'")
    }
    location = parts[3]
    if parts[4] != "settings" {
        return nil, fmt.Errorf("invalid import ID format, must end with 'settings'")
    }

    d.Set("location", location)

    var settingsBlock map[string]interface{}
    switch scopeType {
    case "projects":
        settingsBlock = map[string]interface{}{
            "project": scopeId,
        }
        if err := d.Set("project", scopeId); err != nil {
            return nil, fmt.Errorf("error setting project: %s", err)
        }
        if err := d.Set("project_settings", []interface{}{settingsBlock}); err != nil {
            return nil, fmt.Errorf("error setting project_settings: %s", err)
        }
    case "folders":
        settingsBlock = map[string]interface{}{
            "folder": scopeId,
        }
        if err := d.Set("folder", scopeId); err != nil {
            return nil, fmt.Errorf("error setting folder: %s", err)
        }
        if err := d.Set("folder_settings", []interface{}{settingsBlock}); err != nil {
            return nil, fmt.Errorf("error setting folder_settings: %s", err)
        }
    case "organizations":
        settingsBlock = map[string]interface{}{
            "organization": scopeId,
        }
        if err := d.Set("organization", scopeId); err != nil {
            return nil, fmt.Errorf("error setting organization: %s", err)
        }
        if err := d.Set("organization_settings", []interface{}{settingsBlock}); err != nil {
            return nil, fmt.Errorf("error setting organization_settings: %s", err)
        }
    default:
        return nil, fmt.Errorf("unrecognized scope type in ID: %s", scopeType)
    }

    // The ID is already in the correct format for SetId
    return []*schema.ResourceData{d}, nil
