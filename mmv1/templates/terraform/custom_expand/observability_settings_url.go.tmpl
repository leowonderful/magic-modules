    var scopeType, scopeId string
    location := d.Get("location").(string)

    if px, ok := d.GetOk("project_settings"); ok {
        if len(px.([]interface{})) > 0 {
            projMap := px.([]interface{})[0].(map[string]interface{})
            scopeType = "projects"
            scopeId = projMap["project"].(string)
        }
    } else if fx, ok := d.GetOk("folder_settings"); ok {
        if len(fx.([]interface{})) > 0 {
            folMap := fx.([]interface{})[0].(map[string]interface{})
            scopeType = "folders"
            scopeId = folMap["folder"].(string)
        }
    } else if ox, ok := d.GetOk("organization_settings"); ok {
        if len(ox.([]interface{})) > 0 {
            orgMap := ox.([]interface{})[0].(map[string]interface{})
            scopeType = "organizations"
            scopeId = orgMap["organization"].(string)
        }
    } else {
        return fmt.Errorf("exactly one of project_settings, folder_settings, or organization_settings must be specified")
    }

    if scopeId == "" {
        return fmt.Errorf("missing scope ID within the settings block")
    }

    url = fmt.Sprintf("%s%s/%s/locations/%s/settings", config.ObservabilityBasePath, scopeType, scopeId, location)

    // Field paths for change detection and mask
    defaultStorageLocationPath := ""
    kmsKeyNamePath := ""
    if scopeType == "projects" {
        defaultStorageLocationPath = "project_settings.0.default_storage_location"
        kmsKeyNamePath = "project_settings.0.kms_key_name"
    } else if scopeType == "folders" {
        defaultStorageLocationPath = "folder_settings.0.default_storage_location"
        kmsKeyNamePath = "folder_settings.0.kms_key_name"
    } else { // organizations
        defaultStorageLocationPath = "organization_settings.0.default_storage_location"
        kmsKeyNamePath = "organization_settings.0.kms_key_name"
    }

    // Validate location-specific fields early
    if location == "global" {
        if _, ok := d.GetOk(kmsKeyNamePath); ok {
            return fmt.Errorf("kms_key_name cannot be set for the 'global' location")
        }
    } else { // Regional
        if _, ok := d.GetOk(defaultStorageLocationPath); ok {
            return fmt.Errorf("default_storage_location can only be set for the 'global' location")
        }
    }

    isCreate := d.Id() == ""
    hasDefaultStorageChange := d.HasChange(defaultStorageLocationPath)
    hasKmsKeyChange := d.HasChange(kmsKeyNamePath)

    var maskFields []string
    ApplyMask := false

    if !isCreate && (hasDefaultStorageChange || hasKmsKeyChange) { // pre_update with changes
        ApplyMask = true
        if location == "global" {
            if hasDefaultStorageChange {
                maskFields = append(maskFields, "defaultStorageLocation")
            }
        } else { // Regional
            if hasKmsKeyChange {
                maskFields = append(maskFields, "kmsKeyName")
            }
        }
    }

    if ApplyMask && len(maskFields) > 0 {
        updateMask := strings.Join(maskFields, ",")
        newUrl, qErr := transport_tpg.AddQueryParams(url, map[string]string{"updateMask": updateMask})
        if qErr != nil {
            return qErr
        }
        url = newUrl // Update the URL in the outer scope
    }

    