    location := d.Get("location").(string)
    resource := d.Get("resource").(string)

    if resource == "" {
        return fmt.Errorf("resource field cannot be empty")
    }

    // Construct the base URL dynamically based on the resource prefix
    url = fmt.Sprintf("%s%s/locations/%s/settings", config.ObservabilityBasePath, resource, location)

    // Construct the ID for the resource
    d.SetId(url) // The full path is the ID

    // Build updateMask for PATCH (used for both Create and Update)
    isCreate := d.Id() == "" // This will be false now, but good practice
    var maskFields []string
    log.Printf("[DEBUG] Mask generation: isCreate=%t, location=%s", isCreate, location)

    if location == "global" {
        if d.HasChange("default_storage_location") {
             maskFields = append(maskFields, "defaultStorageLocation")
        }
    } else { // Regional
        if d.HasChange("kms_key_name") {
             maskFields = append(maskFields, "kmsKeyName")
        }
    }

    if len(maskFields) > 0 {
        updateMask := strings.Join(maskFields, ",")
        newUrl, qErr := transport_tpg.AddQueryParams(url, map[string]string{"updateMask": updateMask})
        if qErr != nil {
            return qErr
        }
        url = newUrl
        log.Printf("[DEBUG] Setting updateMask to: %s", updateMask)
    } else {
        log.Printf("[DEBUG] No fields for updateMask")
    }